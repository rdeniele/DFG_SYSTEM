# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Database connection, ONLY for applying migrations from your computer (npm run db:migrate).
# Supabase -> Connect -> "Session pooler" (port 5432). Put your database password in place of [YOUR-PASSWORD].
# Not needed on Vercel.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Server-only. Used by the register + Reset PIN routes and scripts/seed.ts to create test accounts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your live website address. Used inside the clock-in QR, so a QR printed from any computer
# points to the real site. Example: https://darylfitnessgym.vercel.app
NEXT_PUBLIC_SITE_URL=

# Android app download shown on the landing page.
# No Play Store yet: the APK is served from this website (put the file in public/downloads/).
# Later, swap this for the Play Store URL.
NEXT_PUBLIC_ANDROID_APP_URL=/downloads/daryl-fitness-gym.apk
